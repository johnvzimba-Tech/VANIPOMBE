<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.vanipombe.app">

 <application
     android:theme="@style/Theme.VANIPOMBE"
     android:label="@string/app_name"
     android:allowBackup="true"
     android:supportsRtl="true">

  <!-- Form is launcher -->
  <activity android:name=".FormActivity" android:exported="true">
   <intent-filter>
    <action android:name="android.intent.action.MAIN" />
    <category android:name="android.intent.category.LAUNCHER" />
   </intent-filter>
  </activity>

  <!-- Keep existing MainActivity available -->
  <activity android:name=".MainActivity" android:exported="true" />
 </application>
</manifest>
